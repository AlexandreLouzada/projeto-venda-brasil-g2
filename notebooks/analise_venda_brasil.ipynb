      "source": [
        "\n",
        "consulta = '''\n",
        "SELECT canal,\n",
        "       SUM(receita) AS receita_total,\n",
        "       SUM(lucro) AS lucro_total,\n",
        "       SUM(lucro) / SUM(receita) AS margem_lucro\n",
        "FROM vendas\n",
        "GROUP BY canal\n",
        "ORDER BY receita_total DESC\n",
        "'''\n",
        "\n",
        "pd.read_sql(consulta, engine)\n"
      ]
    },
