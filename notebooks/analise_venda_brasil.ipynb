   "source": [
    "# 4. Preparação dos dados"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1d3f8165",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "df[\"data\"] = pd.to_datetime(df[\"data\"], errors=\"coerce\")\n",
    "\n",
    "df[\"ano\"] = df[\"data\"].dt.year\n",
    "df[\"mes\"] = df[\"data\"].dt.month\n",
    "df[\"ano_mes\"] = df[\"data\"].dt.to_period(\"M\").astype(str)\n",
    "\n",
    "df[\"margem_lucro\"] = df[\"lucro\"] / df[\"receita\"]\n",
    "df[\"ticket_medio\"] = df[\"receita\"] / df[\"quantidade\"]\n",
    "\n",
    "df.head()\n"
   ]
  },
